# Declared secrets and settings for HarnessMax. Committed. Values never are.
# Load with `varlock run -- <command>`. Values live in .env.local, which is
# gitignored, or in the OS keyring. Add a key here in the same commit that
# adds the code reading it.
# @defaultRequired=false
# @defaultSensitive=true
# ---

# The developer's own BrowserPod key, for the sandbox spike and local
# development. Users of the shipped app enter theirs in the console.
# @sensitive @type=string
BROWSERPOD_API_KEY=
